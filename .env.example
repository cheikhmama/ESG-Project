# Copy this file to .env and fill in the values.
# The .env file is listed in .gitignore — never commit secrets.

# ── Authentication (Phase 7+) ──────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# Salt for hashing API keys at rest
# Generate with: openssl rand -hex 16
API_KEY_SALT=change-me-in-production

# ── Storage paths ──────────────────────────────────────────────────────────
DATA_DIR=data/
METHODOLOGY_DIR=methodologies/

# ── Logging ────────────────────────────────────────────────────────────────
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# LOG_FORMAT: human (dev) | json (production)
LOG_FORMAT=human

# ── Database (Phase 7+) ────────────────────────────────────────────────────
# DATABASE_URL=sqlite:///data/audit.db
